  "gebuevProcedureAccessBody": "Each accounting export and each archive download is written to the export log: who made it, when, which file and its digest. The audit trail lists these accesses beside the documents.",
  "@gebuevProcedureAccessBody": {
    "description": "#2377 The Swiss archive's procedures document: access logging (GeBüV art. 8)."
  },
  "gebuevProcedureAccessHeading": "Access (art. 8)",
  "@gebuevProcedureAccessHeading": {
    "description": "#2377 The Swiss archive's procedures document: heading."
  },
  "gebuevProcedureCarriersBody": "This archive is read with any zip tool and text editor. A copy of the whole space is proven by a completed workspace export, recorded with its digest: the readiness checklist shows when the last one was made and asks for a new one when it is old.",
  "@gebuevProcedureCarriersBody": {
    "description": "#2377 The Swiss archive's procedures document: availability and carriers (GeBüV art. 5 and 10)."
  },
  "gebuevProcedureCarriersHeading": "Availability and carriers (art. 5 and 10)",
  "@gebuevProcedureCarriersHeading": {
    "description": "#2377 The Swiss archive's procedures document: heading."
  },
  "gebuevProcedureIntegrityBody": "Every file of this archive is listed in manifest.csv with its SHA-256 digest and size. The archive itself, like every accounting export, is recorded in the export log with its digest, the server's time and the person who made it. Each issued document carries the fingerprint the server verifies; register.csv states the verdict.",
  "@gebuevProcedureIntegrityBody": {
    "description": "#2377 The Swiss archive's procedures document: integrity (GeBüV art. 3 and 9)."
  },
  "gebuevProcedureIntegrityHeading": "Integrity (art. 3 and 9)",
  "@gebuevProcedureIntegrityHeading": {
    "description": "#2377 The Swiss archive's procedures document: heading."
  },
  "gebuevProcedureSystemBody": "DesKilo keeps this space's invoices, credit notes, payments, member accounts, shared costs and approved purchase documents, and, where the space keeps a local book, their postings on its chart. The accountant's general ledger imports the Swiss journal of those postings.",
  "@gebuevProcedureSystemBody": {
    "description": "#2377 The Swiss archive's procedures document: what the system keeps."
  },
