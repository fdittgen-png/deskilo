  "helpHintPrivacyTopic": "Privacy",
  "@helpHintPrivacyTopic": {
    "description": "#718/#719 - help hints"
  },
  "helpHintPrivacyTip2": "Messages are readable only by the people in the conversation, whatever their role; money only by you and the finance permission.",
  "@helpHintPrivacyTip2": {
    "description": "#718/#719 - help hints"
  },
  "helpHintPrivacyTip3": "Every read of your finances by someone else is logged by the server — the log cannot be skipped or edited.",
