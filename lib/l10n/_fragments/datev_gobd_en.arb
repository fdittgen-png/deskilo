  "gobdProcedureImmutableHeading": "Unalterability",
  "@gobdProcedureImmutableHeading": {
    "description": "Procedure documentation (#2375): heading"
  },
  "gobdProcedureImmutableBody": "An issued invoice or credit note cannot be changed or deleted: the database refuses it. Each document is signed into a chain with the one before it. A correction is a new document (a credit note or a replacement) that names the one it corrects. A closed period refuses cancellations and payments dated inside it.",
  "@gobdProcedureImmutableBody": {
    "description": "Procedure documentation (#2375): how issued documents are protected"
  },
