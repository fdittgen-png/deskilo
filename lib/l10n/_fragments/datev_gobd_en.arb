        "type": "String"
      }
    }
  },
  "gobdProcedureHandoverHeading": "Data handover (Z3)",
  "@gobdProcedureHandoverHeading": {
    "description": "Procedure documentation (#2375): heading"
  },
  "gobdProcedureHandoverBody": "This package follows the Beschreibungsstandard: index.xml describes every table, its columns, keys and joins, and names the DTD gdpdu-01-08-2002.dtd delivered beside it. Each table is a UTF-8 CSV file without a header line. The folder belege holds each invoice's structured e-invoice and, where it was rendered, its PDF/A-3 with that XML embedded.",
  "@gobdProcedureHandoverBody": {
    "description": "Procedure documentation (#2375): what the package holds"
  },
  "gobdProcedureExportsHeading": "Exports",
  "@gobdProcedureExportsHeading": {
    "description": "Procedure documentation (#2375): heading"
  },
  "gobdProcedureExportsBody": "Every accounting export is recorded in the export log with its period, size and SHA-256 digest; an export of a closed period gives the same bytes again.",
  "@gobdProcedureExportsBody": {
    "description": "Procedure documentation (#2375): the export log"
  }
