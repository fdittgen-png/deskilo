    "description": "#4162 the same, for a price quoted for more than one unit (e.g. '30 kg at 12.5 EUR per 10 kg')",
    "placeholders": {
      "quantity": {
        "type": "String"
      },
      "price": {
        "type": "String"
      },
      "base": {
        "type": "String"
      }
    }
  },
  "commercialLineUnreadable": "Recorded by a newer version: these facts are shown as written and cannot be used here",
