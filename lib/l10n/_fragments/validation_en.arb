{
  "@@locale": "en",
  "eventValidations": "{current}/{required} validations",
  "@eventValidations": {
    "description": "Quorum progress on a pending event (#130): accepts so far / accepts required",
    "placeholders": {
      "current": {
        "type": "int"
      },
      "required": {
        "type": "int"
      }
    }
  },
  "eventValidatedBy": "Validated by {name} · {when}",
  "@eventValidatedBy": {
    "description": "Audit-trail row for an accept decision",
    "placeholders": {
      "name": {
        "type": "String"
      },
      "when": {
        "type": "String"
      }
    }
  },
  "eventRejectedBy": "Declined by {name} · {when}",
  "@eventRejectedBy": {
    "description": "Audit-trail row for a reject decision",
    "placeholders": {
      "name": {
        "type": "String"
      },
      "when": {
        "type": "String"
      }
    }
  },
  "eventSystemDecider": "System",
  "@eventSystemDecider": {
    "description": "Validator name shown when the timeout sweep decided, not a member"
  },
  "validationTrailTitle": "Validation trail",
  "@validationTrailTitle": {
    "description": "#841 - heading of the ordered decision trail on a document"
  },
  "validationTrailNone": "No decision yet.",
  "@validationTrailNone": {
    "description": "#841 - the trail when nothing has been decided yet"
  },
  "validationTrailStep": "Step {order}",
  "@validationTrailStep": {
    "description": "#841 - leader of one entry when the rule asks one validation at a time",
    "placeholders": {
      "order": {
        "type": "int"
      }
    }
  },
  "validationTrailAwaiting": "{count, plural, =1{Awaiting 1 more validation.} other{Awaiting {count} more validations.}}",
  "@validationTrailAwaiting": {
    "description": "#841 - how many validations the event still owes",
    "placeholders": {
      "count": {
        "type": "int"
      }
    }
  },
  "eventValidationStage": "Validation {stage} of {required} requested",
  "@eventValidationStage": {
    "description": "#848 - which step of a chained rule is open",
    "placeholders": {
      "stage": {
        "type": "int"
      },
      "required": {
        "type": "int"
      }
    }
  }
}
