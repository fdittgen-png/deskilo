  "featureBookingPoliciesTitle": "Booking policies",
  "featureBookingPoliciesDesc": "Owner-configurable booking behavior: past bookings, minute bookings outside the working hours, and check-out by admins.",
  "featureNfcSeatTagsTitle": "NFC/RFID chair tags",
  "featureNfcSeatTagsDesc": "A physical NFC/RFID tag on a chair resolves to its seat like the printed QR card; owners fill the tag field by tapping the chip.",
  "featureQrBadgesTitle": "QR badges",
  "featureQrBadgesDesc": "Printable QR badge cards for the kiosk, beside the NFC/RFID cards.",
  "featureFormHelpHintsTitle": "Help hints",
  "featureFormHelpHintsDesc": "A dismissible tip carousel on every main screen, and a small ? beside every parameter and entry field — one tap opens the guide at the right section. Restorable from Settings.",
  "featureUiAnimationsTitle": "Interface animations",
  "featureUiAnimationsDesc": "Smooth transitions and state animations across the app. Off means every change is instant; the device's reduced-motion setting always wins.",
  "featureKioskMemberPhotosTitle": "Member photos at the kiosk",
  "featureKioskMemberPhotosDesc": "The kiosk receipt shows the member's profile photo — the visual wrong-badge check.",
  "featurePlanMemberPhotosTitle": "Member photos on the plan",
  "featurePlanMemberPhotosDesc": "Occupied seats on the Plan tab and Reserve hub show the occupant's profile photo instead of the initial.",
  "featureBadgeSignInTitle": "Sign in with a badge",
  "@featureBadgeSignInTitle": {
    "description": "#662 - feature registry entry"
  },
  "featureBadgeSignInDesc": "Members can sign in by scanning their badge and entering their PIN, instead of typing an e-mail on a shared tablet. Each member sets their own PIN and arms their own badge.",
  "@featureBadgeSignInDesc": {
    "description": "#662 - feature registry entry"
  },
