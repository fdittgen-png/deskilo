  "featureWorkingHours": "Working hours",
  "featureWorkingHoursDesc": "Configure the working day and offer exact-hours booking; off keeps the 8:00–17:00 defaults.",
  "featureInvoicePdfTemplate": "Invoice PDF template",
  "featureInvoicePdfTemplateDesc": "Owner-written intro and footer text on the invoice PDF. Never touches the e-invoice XML.",
  "featureMemberNotifications": "Member notifications",
  "featureMemberNotificationsDesc": "Messaging between members: private and group conversations, read receipts, links to a reservation or a space; admins can notify all admins, owner included.",
  "featureDunning": "Payment reminders (Mahnwesen)",
  "@featureDunning": {
