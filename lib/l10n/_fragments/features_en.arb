  },
  "featureBookingPoliciesTitle": "Booking policies",
  "featureBookingPoliciesDesc": "Owner-configurable booking behavior: past bookings, minute bookings outside the working hours, and check-out by admins.",
  "featureNfcSeatTagsTitle": "NFC/RFID chair tags",
  "featureNfcSeatTagsDesc": "A physical NFC/RFID tag on a chair resolves to its seat like the printed QR card; owners fill the tag field by tapping the chip.",
  "featureQrBadgesTitle": "QR badges",
  "featureQrBadgesDesc": "Printable QR badge cards for the kiosk, beside the NFC/RFID cards.",
  "featureFormHelpHintsTitle": "Help hints",
  "featureFormHelpHintsDesc": "A dismissible tip carousel on every main screen, and a small ? beside every parameter and entry field — one tap opens the guide at the right section. Restorable from Settings.",
  "featureUiAnimationsTitle": "Interface animations",
  "featureUiAnimationsDesc": "Smooth transitions and state animations across the app. Off means every change is instant; the device's reduced-motion setting always wins.",
  "featureKioskMemberPhotosTitle": "Member photos at the kiosk",
  "featureKioskMemberPhotosDesc": "The kiosk receipt shows the member's profile photo — the visual wrong-badge check.",
  "featurePlanMemberPhotosTitle": "Member photos on the plan",
  "featurePlanMemberPhotosDesc": "Occupied seats on the Plan tab and Reserve hub show the occupant's profile photo instead of the initial.",
  "featureBadgeSignInTitle": "Sign in with a badge",
  "@featureBadgeSignInTitle": {
    "description": "#662 - feature registry entry"
  },
  "featureBadgeSignInDesc": "Members can sign in by scanning their badge and entering their PIN, instead of typing an e-mail on a shared tablet. Each member sets their own PIN and arms their own badge.",
  "@featureBadgeSignInDesc": {
    "description": "#662 - feature registry entry"
  },
  "featureRegionalFormatsTitle": "Region & formats",
  "@featureRegionalFormatsTitle": {
    "description": "#711 - globalization"
  },
  "featureRegionalFormatsDesc": "Members choose how numbers, dates, the clock and the time zone are shown to them. Off: everyone reads in the app language's home region, 24-hour, workspace time.",
  "@featureRegionalFormatsDesc": {
    "description": "#711 - globalization"
  },
  "featureCalendarHubTitle": "Calendar hub",
  "@featureCalendarHubTitle": {
    "description": "#718/#719"
  },
  "featureCalendarHubDesc": "The calendar shows everything dated — bookings, check-ins, alerts, messages, invoices, payments, consumption, reminders — for a day or a range, each row opening its source. Off: reservations only.",
  "@featureCalendarHubDesc": {
    "description": "#718/#719"
  },
  "featureDataAccessLogTitle": "Data access log",
  "@featureDataAccessLogTitle": {
    "description": "#718/#719"
  },
  "featureDataAccessLogDesc": "Members see who looked at their finances and when (written by the server, never skippable). Off hides the row; the log is still kept.",
  "@featureDataAccessLogDesc": {
    "description": "#718/#719"
  },
  "featureMemberDataExportTitle": "Export & erasure",
  "@featureMemberDataExportTitle": {
    "description": "#718/#719"
  },
  "featureMemberDataExportDesc": "Every member can export their data as one file (GDPR art. 20) and leave the workspace with their personal data cleared (art. 17) from Settings → Privacy & data.",
  "@featureMemberDataExportDesc": {
    "description": "#718/#719"
  },
  "featureFinanceFacesTitle": "Finances in four faces",
  "featureFinanceFacesDesc": "The Finances tab reads as four faces — Statement, Payments, Invoices, Documents — under one month chooser, each with its own help. Off: a single column.",
  "featurePaymentRemindersTitle": "Automatic payment reminders",
  "featurePaymentRemindersDesc": "Open invoices past the configured term get their reminder levels automatically — an alert in the member's feed and a push, once a day. Off: reminders stay a manual action.",
  "featureSupplyExpensesTitle": "Supplies from expenses",
  "featureSupplyExpensesDesc": "An expense can be a supply for the space (coffee capsules, vacuum bags…): once validated it restocks or creates a consumable service with a unit price, and consumptions count the stock down.",
  "featureValidationScopesTitle": "Validators by role or person",
  "featureValidationScopesDesc": "Each validation rule names who validates: the admins, listed persons of any role, or every member — plus how many. Off: owner and admins as before.",
  "featurePriceNegotiationsTitle": "Price negotiations",
  "featurePriceNegotiationsDesc": "The tariff is the default; a member can hold their own conditions — monthly fee, overage rate, discount on supplements, unit prices per service and package, the occupation percentage — proposed by whoever holds Manage commercial agreements and validated by the rules. Seen by the member, the owners and the holders of View commercial agreements; every read is logged.",
  "featureScheduledExpensesTitle": "Scheduled expenses",
  "featureUniqueMonogramsTitle": "Distinct avatar initials",
  "featureMessageGesturesTitle": "Swipe to quote or take back",
  "featureSubscriptionInvoicesTitle": "Subscription invoices",
  "featureSubscriptionInvoicesDesc": "The membership fee is invoiced before the month it pays for, on a date you choose. Off: the fee stays on the whole-month invoice.",
  "featureUsageInvoicesTitle": "End-of-month invoices",
  "featureUsageInvoicesDesc": "Once a month is over, what it actually cost beyond the subscription — overage, accessories, services — is invoiced separately. Off: those stay on the whole-month invoice.",
  "featureInvoiceSettlementTitle": "Regroup invoices",
  "featureInvoiceSettlementDesc": "Several of a member's open invoices can be regrouped into one they pay. The originals stay in the archive, traceable position by position, and stop being chased separately.",
