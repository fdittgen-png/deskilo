{
  "@@locale": "en",
  "featureSpaceInquiriesTitle": "Write to the hosts",
  "@featureSpaceInquiriesTitle": {
    "description": "#1824 messenger flags: featureSpaceInquiriesTitle"
  },
  "featureSpaceInquiriesDesc": "A signed-in person who finds the published page can write to the hosts: the owners, and the administrators who chose to be public contacts. The hosts are named before anyone writes, and only that person and the hosts read the conversation. Off removes the button and the Inquiries view, so nobody starts a new inquiry; open ones stay in the hosts' inbox to answer and close.",
  "@featureSpaceInquiriesDesc": {
    "description": "#1824 messenger flags: featureSpaceInquiriesDesc"
  },
  "featureMessageForwardingTitle": "Message forwarding",
  "@featureMessageForwardingTitle": {
    "description": "#1824 messenger flags: featureMessageForwardingTitle"
  },
  "featureMessageForwardingDesc": "A message can be forwarded into another conversation the forwarder takes part in. The copy names where it came from and who wrote it, the original conversation is told who forwarded it and where, and an author can lock a message against forwarding. Off refuses forwards out of this space.",
  "@featureMessageForwardingDesc": {
    "description": "#1824 messenger flags: featureMessageForwardingDesc"
  },
  "featureCaptureProtectionTitle": "Screen capture protection",
  "@featureCaptureProtectionTitle": {
    "description": "#1824 messenger flags: featureCaptureProtectionTitle"
  },
  "featureCaptureProtectionDesc": "Message screens refuse screenshots and screen recording where the device allows it, hide their content while the screen is recorded, and announce a screenshot in the conversation where it can only be detected. A browser cannot block screenshots; there the thread is blurred when the tab loses focus.",
  "@featureCaptureProtectionDesc": {
    "description": "#1824 messenger flags: featureCaptureProtectionDesc"
  },
  "featureMessageMentionsTitle": "Mentions in groups",
  "@featureMessageMentionsTitle": {
    "description": "#2216 messenger flags: featureMessageMentionsTitle"
  },
  "featureMessageMentionsDesc": "In a group, a person can be mentioned by name. Only people in the conversation can be mentioned, and the person mentioned is notified even when they have muted it. Off, a name typed after @ is plain text and notifies nobody.",
  "@featureMessageMentionsDesc": {
    "description": "#2216 messenger flags: featureMessageMentionsDesc"
  }
}
