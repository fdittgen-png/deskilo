{
  "@@locale": "en",
  "visibilitySavedPreview": "Saved preview",
  "@visibilitySavedPreview": {
    "description": "#2558 privacy: label of the preview, which shows only what the personal home saved"
  },
  "visibilitySavedPreviewHint": "Shows what is saved. A change appears here once it is saved.",
  "@visibilitySavedPreviewHint": {
    "description": "#2558 privacy: under the saved preview label; an unsaved change is never shown in it"
  },
  "visibilityUnsupported": "Your personal home cannot save this setting yet: the people who run it need to update it. Nothing was changed.",
  "@visibilityUnsupported": {
    "description": "#2558 privacy: the personal home lacks the checked privacy writer (incomplete deployment); nothing was written"
  },
  "visibilityLegacyTitle": "Legacy personal accounts",
  "@visibilityLegacyTitle": {
    "description": "#2558 privacy: expandable section of the separate accounts the person has on other servers"
  },
  "visibilityLegacyIntro": "Your separate accounts on other servers keep their own settings. Changing your personal home does not change them.",
  "@visibilityLegacyIntro": {
    "description": "#2558 privacy: subtitle of the legacy personal accounts section"
  },
  "visibilityLegacyUnsaved": "Not saved yet: {audience}",
  "@visibilityLegacyUnsaved": {
    "description": "#2558 privacy: a legacy account field with a change that is not saved yet",
    "placeholders": {
      "audience": {
        "type": "String",
        "example": "Members of my spaces"
      }
    }
  },
  "visibilityLegacyDiscard": "Discard change",
  "@visibilityLegacyDiscard": {
    "description": "#2558 privacy: drop the unsaved change of a legacy account"
  },
  "visibilityLegacyKeepEditing": "Keep editing",
  "@visibilityLegacyKeepEditing": {
    "description": "#2558 privacy: stay on the legacy account with the unsaved change"
  },
  "visibilityLegacyDirtyTitle": "Your change is not saved",
  "@visibilityLegacyDirtyTitle": {
    "description": "#2558 privacy: switching to another legacy account while a change is unsaved"
  },
  "visibilityLegacyDirtyBody": "Your change to “{field}” on {server} is not saved yet. It belongs to that account and does not move to another one.",
  "@visibilityLegacyDirtyBody": {
    "description": "#2558 privacy: body of the save / discard / keep editing question when switching legacy accounts",
    "placeholders": {
      "field": {
        "type": "String",
        "example": "Contact details"
      },
      "server": {
        "type": "String",
        "example": "coworkonti.example"
      }
    }
  }
}
