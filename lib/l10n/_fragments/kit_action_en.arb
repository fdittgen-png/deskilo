{
  "kitActionBusy": "Working…",
  "@kitActionBusy": {
    "description": "Spoken by a screen reader on a button whose action is running; the button cannot be pressed again until it completes."
  },
  "kitScrollBack": "Scroll back",
  "@kitScrollBack": {
    "description": "Tooltip of the arrow on a sideways strip that pages it back towards its start; shown only while a mouse is the pointer."
  },
  "kitScrollForward": "Scroll forward",
  "@kitScrollForward": {
    "description": "Tooltip of the arrow on a sideways strip that pages it on towards its end; shown only while a mouse is the pointer."
  }
}
