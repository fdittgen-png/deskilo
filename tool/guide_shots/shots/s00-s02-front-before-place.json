    {
     "click": "@helpHintDismiss"
    },
    {
     "wait": 800
    },
    {
     "scroll": 500,
     "wait": 1200
    }
   ]
  },
  {
   "id": "setup-place-rooms",
   "persona": "owner",
   "full": false,
