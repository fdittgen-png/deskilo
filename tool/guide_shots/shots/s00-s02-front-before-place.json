   "steps": [
    {
     "hash": "#/onboarding?join=1"
    },
    {
     "click": "@onboardingCreateTab"
    },
    {
     "at": [
      195,
      202
     ],
     "wait": 800
    },
    {
     "type": "Studio Lumen"
    },
    {
     "click": "@wizardNext",
     "wait": 1800
    },
    {
     "click": "@wizardNext",
     "wait": 1800
    }
   ]
  },
  {
   "id": "setup-place-country",
   "persona": "owner",
   "full": false,
