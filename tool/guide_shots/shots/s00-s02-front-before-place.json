    {
     "hash": "#/editor"
    },
    {
     "click": "Ground floor"
    },
    {
     "wait": 2500
    }
   ]
  },
  {
   "id": "setup-place-availability",
   "persona": "owner",
   "clip": false,
   "shows": "the availability screen, cut by decision",
   "steps": [
    {
     "hash": "#/availability"
    }
   ],
   "parts": [
    {
     "id": "times",
     "from": "@availabilityOpenWeekdays",
     "to": "@availabilityPoliciesTitle",
     "pad": 0
    },
    {
     "id": "rules",
     "from": "@availabilityPoliciesTitle",
     "to": "@availabilityClosureDays",
     "pad": 0
    },
    {
     "id": "closure",
     "from": "@availabilityClosureDays",
     "pad": 0,
     "to": [
      "May 1, 2023",
      "1 mai 2023",
      "1. Mai 2023",
      "1 de mayo de 2023",
      "1 maggio 2023"
     ]
    }
   ]
  },
  {
