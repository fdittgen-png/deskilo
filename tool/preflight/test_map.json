{
  "_": "#3715 -- the tests that must run when a path changes, beyond the generators: a path pattern (`*` inside a name, `**` across folders) -> test files or folders. The importers of a changed lib file are found by search, not listed here. `dart run tool/preflight.dart --list` prints the result for the branch's diff; test/lint/preflight_test_map_test.dart keeps this table true. Generated files (`no_importer_search`) still trigger the table's rows but their importers are not searched: an ARB change rewrites the localizations and would otherwise list every test.",
  "rows": [
    {
      "patterns": [
        "lib/app/routes/**",
        "lib/app/route_classes.dart",
        "lib/app/router.dart",
        "lib/app/shell/shell_routes.dart",
        "lib/app/shell/shell_destinations.dart",
        "lib/app/route_redirect.dart",
        "lib/app/route_access.dart",
        "lib/app/route_policy.dart",
        "lib/core/navigation/page_spec.dart",
        "lib/features/me/presentation/me_personal_shell.dart"
      ],
      "tests": [
        "test/app/route_outcomes_golden_test.dart",
        "test/features/task_recorder/coverage_manifest_test.dart",
        "test/lint/route_registry_test.dart",
        "test/lint/recorder_vocabulary_drift_test.dart"
      ]
    },
    {
      "patterns": [
        "tool/**"
      ],
      "tests": [
        "test/tool/"
      ]
    },
    {
      "patterns": [
        "lib/l10n/_fragments/**"
      ],
      "tests": [
        "test/i18n/"
      ]
    },
    {
      "patterns": [
        "lib/features/workspace/domain/setup_*",
        "web/setup*",
        "tool/setup/**"
      ],
      "tests": [
        "test/lint/setup_levels_web_test.dart",
        "test/lint/setup_levels_contract_test.dart",
        "test/features/workspace/setup_levels_test.dart"
      ]
    },
    {
      "patterns": [
        "lib/core/ui/kit/**"
      ],
      "tests": [
        "test/ux/",
        "test/core/ui/"
      ]
    },
    {
      "patterns": [
        "lib/main.dart",
        "lib/core/demo/demo_space_routing.dart"
      ],
      "tests": [
        "test/core/demo/demo_scope_test.dart",
        "test/core/demo/demo_scope_reach_test.dart"
      ]
    },
    {
      "patterns": [
        "test/lint/*.dart"
      ],
      "tests": [
        "test/lint/lint_sources_test.dart"
      ]
    }
  ],
  "no_importer_search": [
    "lib/l10n/app_localizations*.dart",
    "**/*.g.dart",
    "**/*.freezed.dart"
  ]
}
