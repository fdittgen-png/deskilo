class Box {
  Box(
    this.a, {
    required this.b,
    int c = 3,
  })  : d = c > 1 ? 1 : 0 {
    if (a) {
      b;
    }
  }

  final bool a;
  final int b;
  final int d;

  String describe(
    int first,
    String second, [
    bool third = false,
  ]) =>
      first > 0 ? second : '';

  int get twice => b * 2;
}
