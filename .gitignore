# Flutter/Dart
.dart_tool/
.packages
build/
.flutter-plugins
.flutter-plugins-dependencies
.fvm/
coverage/
# #1558 — the push packages resolve their own dev dependencies when
# their suite runs; only the app's lockfile is pinned.
packages/*/pubspec.lock

# IDE
.idea/
*.iml
.vscode/

# Platform
ios/Pods/
ios/.symlinks/
ios/Flutter/Flutter.podspec
android/.gradle/
android/local.properties
android/key.properties
key.properties
*.jks
*.keystore
*.p12

# Secrets / local
.env
*.local
.claude/settings.local.json
# .claude/settings.json IS tracked on purpose: it carries the shared MCP
# permission allow-list, so a fresh clone gets the same tooling posture.
# Per-machine opt-ins (the Supabase write tools) live in the local file above.
.claude/worktrees/

# macOS
.DS_Store

# #1017 — the documentation media workbench: the index of what each
# screenshot shows, and the intermediates. Deliberately NOT tracked; the
# originals in docs/media/source/ carry the same identity, so
# `dart run tool/media.dart index` rebuilds it.
.media-workbench/

# sed -i.orig leftovers; one reached git four times before #1505 removed it
*.orig

# where the suite logs go (deskilo-ship-feature step 3)
scratchpad/
