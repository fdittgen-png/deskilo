default_platform(:ios)

# Builds an App Store Connect API key payload that match / pilot can consume.
# Locally: set ASC_API_KEY_FILEPATH to the on-disk .p8.
# In CI:    set APP_STORE_CONNECT_API_KEY_BASE64 to the base64 of the .p8.
# (Same env-name convention as tankstellen — deliberately distinct from
# fastlane's auto-discovered APP_STORE_CONNECT_API_KEY_PATH.)
def asc_api_key
  base64_content = ENV["APP_STORE_CONNECT_API_KEY_BASE64"]
  app_store_connect_api_key(
    key_id: ENV.fetch("APP_STORE_CONNECT_API_KEY_ID"),
    issuer_id: ENV.fetch("APP_STORE_CONNECT_API_ISSUER_ID"),
    key_filepath: ENV["ASC_API_KEY_FILEPATH"],
    key_content: base64_content,
    is_key_content_base64: !base64_content.nil?,
    in_house: false,
  )
end

# ---------------------------------------------------------------------------
# Beta App Review test-info — single source of truth (tankstellen #2611/#2612
# pattern). Consumed by `upload_testflight distribute_external:true`, so even
# a fresh app record has its Beta App Review data filled with the build.
# ---------------------------------------------------------------------------

# Localized "Beta App Description" shown to TestFlight reviewers and external
# testers, keyed by ASC locale. NOTE: App Store Connect's Italian locale code
# is "it", NOT "it-IT" (fastlane deliver/lib/deliver/languages.rb — "it-IT"
# is rejected with "The 'locale' value is invalid").
BETA_APP_DESCRIPTIONS = {
  "en-US" => "DesKilo is a free, privacy-first app for small self-organized coworking communities: draw your space as a visual floor plan, reserve seats, desks, rooms or whole levels, check in on site, message members, and manage fair member billing with invoices and reports. Open source (MIT).",
  "fr-FR" => "DesKilo est une app gratuite et respectueuse de la vie privée pour les petites communautés de coworking auto-organisées : dessinez votre espace en plan visuel, réservez sièges, tables, bureaux ou niveaux entiers, pointez sur place, échangez des messages et gérez une facturation équitable avec factures et rapports. Open source (MIT).",
  "de-DE" => "DesKilo ist eine kostenlose, datenschutzfreundliche App für kleine selbstorganisierte Coworking-Gemeinschaften: zeichne deinen Raum als visuellen Grundriss, reserviere Sitze, Tische, Büros oder ganze Etagen, checke vor Ort ein, schreibe Mitgliedern Nachrichten und verwalte faire Abrechnung mit Rechnungen und Berichten. Open Source (MIT).",
  "es-ES" => "DesKilo es una app gratuita y respetuosa con la privacidad para pequeñas comunidades de coworking autoorganizadas: dibuja tu espacio como plano visual, reserva asientos, mesas, salas o plantas enteras, regístrate in situ, envía mensajes a los miembros y gestiona una facturación justa con facturas e informes. Código abierto (MIT).",
  "it" => "DesKilo è un'app gratuita e rispettosa della privacy per piccole comunità di coworking auto-organizzate: disegna il tuo spazio come pianta visuale, prenota posti, tavoli, stanze o interi piani, fai check-in sul posto, scambia messaggi con i membri e gestisci una fatturazione equa con fatture e report. Open source (MIT).",
}.freeze

# Read an env var, falling back to `default` when unset OR empty — CI passes
# optional secrets through as "" (`|| ''`), which ENV.fetch would keep.
def beta_env(name, default)
  value = ENV[name]
  (value.nil? || value.strip.empty?) ? default : value.strip
end

# Feedback email shown to beta testers (overridable via BETA_FEEDBACK_EMAIL).
def beta_feedback_email
  beta_env("BETA_FEEDBACK_EMAIL", "fdittgen@gmail.com")
end

# App-Review contact block in *snake_case* — the casing pilot's
# `beta_app_review_info` expects. Returns nil when BETA_CONTACT_PHONE is
# unset so a plain upload doesn't crash; the phone is mandatory for the
# Beta App Review submission and must come from the repo secret (never
# fabricated). DesKilo REQUIRES sign-in, so the demo account (a real test
# login the owner creates, secrets BETA_DEMO_EMAIL/BETA_DEMO_PASSWORD) is
# what lets the review team past the auth screen.
def beta_review_contact_info_snake
  phone = ENV["BETA_CONTACT_PHONE"]
  return nil if phone.nil? || phone.strip.empty?

  demo_email = ENV["BETA_DEMO_EMAIL"]
  demo_password = ENV["BETA_DEMO_PASSWORD"]
  has_demo = !(demo_email.nil? || demo_email.strip.empty? ||
               demo_password.nil? || demo_password.strip.empty?)
  info = {
    contact_first_name: beta_env("BETA_CONTACT_FIRST", "Florian"),
    contact_last_name: beta_env("BETA_CONTACT_LAST", "Dittgen"),
    contact_phone: phone.strip,
    contact_email: beta_feedback_email,
    demo_account_required: has_demo,
    notes: "DesKilo requires sign-in (email + password). Use the demo " \
           "account to log in; it is already a member of a demo workspace, " \
           "so every feature (floor plan, reservations, check-in, messages, " \
           "billing views) is reachable immediately. Free, ad-free, open " \
           "source (MIT).",
  }
  if has_demo
    info[:demo_account_name] = demo_email.strip
    info[:demo_account_password] = demo_password.strip
  else
    UI.important("BETA_DEMO_EMAIL/BETA_DEMO_PASSWORD unset — submitting " \
                 "WITHOUT demo credentials. DesKilo requires sign-in, so " \
                 "Beta App Review will likely reject: set the secrets to a " \
                 "real test account inside a demo workspace.")
  end
  info
end

platform :ios do
  # A DEDICATED, unlocked keychain on CI.
  #
  # Without it match imports the certificate into login.keychain, whose
  # password no one on a headless runner knows — so `codesign` puts up a
  # prompt nobody can answer and the job sits there until the workflow
  # timeout kills it. That is exactly how the first TestFlight build died:
  # normal output until the archive, then 54 minutes of silence.
  #
  # `setup_ci` creates a temporary keychain, unlocks it, and sets the
  # partition list so codesign may use the key unattended.
  before_all do
    setup_ci if ENV["CI"] == "true"
  end

  desc "Fetch the appstore distribution cert + profile (readonly on CI)."
  lane :match_appstore do
    match(type: "appstore", api_key: asc_api_key)
  end

  desc "One-time bootstrap on a trusted workstation: generate certs/profiles."
  lane :match_bootstrap do
    UI.user_error!("Refusing to bootstrap from CI — run this lane locally") if ENV["CI"] == "true"
    key = asc_api_key
    match(type: "development", api_key: key, readonly: false)
    match(type: "appstore", api_key: key, readonly: false)
  end

  desc "Repair/init: (re)generate the appstore profile for de.deskilo.app into"
  desc "the shared certs repo. Registers the bundle id at Apple if missing."
  desc "Needs a WRITE deploy key. Run via the workflow's sync_certs input."
  lane :match_sync_appstore do
    # force: true so entitlement changes are picked up too (tankstellen #3467).
    match(type: "appstore", api_key: asc_api_key, readonly: false, force: true)
  end

  desc "Build a signed appstore-distribution IPA (match_appstore ran first)."
  lane :build_appstore do |options|
    build_number = options[:build_number] || ENV["IOS_BUILD_NUMBER"] || Time.now.strftime("%Y%m%d")
    profile_name = ENV["sigh_de.deskilo.app_appstore_profile-name"] || "match AppStore de.deskilo.app"

    # MANUAL signing for the archive. The project ships with Flutter's
    # default (automatic, "iPhone Developer", no profile specifier), so
    # xcodebuild goes looking for a profile nobody told it about and fails
    # with "No profiles for 'de.deskilo.app' were found" — even though
    # match has just installed exactly that profile. tankstellen has the
    # same three settings baked into its .pbxproj; doing it here instead
    # keeps the checked-in project on automatic signing, so opening it in
    # Xcode with a personal team still works.
    update_code_signing_settings(
      path: "Runner.xcodeproj",
      use_automatic_signing: false,
      team_id: "C4Y5RDF8P9",
      code_sign_identity: "Apple Distribution",
      bundle_identifier: "de.deskilo.app",
      profile_name: profile_name,
      targets: ["Runner"],
      build_configurations: ["Release"],
    )

    # `flutter build ipa` doesn't expose manual-signing options for
    # match-managed certs, so build with Flutter (no codesign) and let gym
    # drive xcodebuild. Bundler env is stripped so flutter's internal
    # `pod install` finds a loadable CocoaPods (tankstellen lesson).
    Bundler.with_unbundled_env do
      # The build number goes in HERE, not through agvtool: the project's
      # CURRENT_PROJECT_VERSION is $(FLUTTER_BUILD_NUMBER), so Flutter's own
      # flag is what actually reaches CFBundleVersion. (agvtool answered
      # `Cannot find "Runner.xcodeproj/../YES"` and left the version alone,
      # which App Store Connect would have rejected as a duplicate upload.)
      sh("flutter build ios --release --no-codesign " \
         "--build-number=#{build_number} " \
         "--obfuscate --split-debug-info=../build/symbols")
    end

    build_app(
      workspace: "Runner.xcworkspace",
      scheme: "Runner",
      configuration: "Release",
      output_directory: "../build/ios/ipa",
      output_name: "Runner.ipa",
      export_method: "app-store",
      export_options: {
        provisioningProfiles: {
          "de.deskilo.app" => profile_name,
        },
        signingStyle: "manual",
        teamID: "C4Y5RDF8P9",
      },
      clean: false,
      include_symbols: true,
      include_bitcode: false,
    )
  end

  desc "Upload build/ios/ipa/Runner.ipa to TestFlight (internal testers,"
  desc "no review). Pass distribute_external:true to ALSO push the build to"
  desc "the external 'Coworking externe' group — the one behind the public"
  desc "link — which submits it for Beta App Review (tankstellen #2612"
  desc "pattern; only the FIRST external build waits on Apple, later ones"
  desc "reach the group directly)."
  lane :upload_testflight do |options|
    changelog = options[:changelog] || ENV["TESTFLIGHT_CHANGELOG"] || "Internal build."
    # Strict boolean: release_testflight may forward nil, the workflow
    # passes the string "true"/"false".
    raw_distribute = options.fetch(:distribute_external, false)
    distribute_external = [true, "true", "1"].include?(raw_distribute)

    pilot_args = {
      api_key: asc_api_key,
      app_identifier: "de.deskilo.app",
      team_id: "C4Y5RDF8P9",
      ipa: "../build/ios/ipa/Runner.ipa",
      changelog: changelog,
      distribute_external: distribute_external,
    }

    if distribute_external
      # The build must finish processing before pilot can attach it to the
      # external group and submit it for Beta App Review — no skipping the
      # wait. Don't spam testers with emails; the public link is the door.
      pilot_args[:skip_waiting_for_build_processing] = false
      pilot_args[:groups] = ["Coworking externe"]
      pilot_args[:notify_external_testers] = false

      # Carry the localized test info + contact block inline, so even a
      # fresh app record has its Beta App Review data filled.
      pilot_args[:beta_app_description] = BETA_APP_DESCRIPTIONS["en-US"]
      pilot_args[:localized_app_info] =
        BETA_APP_DESCRIPTIONS.each_with_object({}) do |(locale, description), acc|
          acc[locale] = {
            feedback_email: beta_feedback_email,
            description: description,
          }
        end

      contact = beta_review_contact_info_snake
      if contact
        pilot_args[:beta_app_review_info] = contact
      else
        UI.important("BETA_CONTACT_PHONE unset — distributing externally " \
                     "WITHOUT the App-Review contact block. Set the secret " \
                     "so Beta App Review can clear.")
      end
    else
      # Internal-only upload: nothing to review, skip the processing wait.
      pilot_args[:skip_waiting_for_build_processing] = true
    end

    pilot(**pilot_args)
  end

  desc "Make sure Apple knows about de.deskilo.app, and SAY what it knows."
  desc "Registers the bundle id if missing (that part an API key may do) and"
  desc "then reports every app record the key can see with its bundle id —"
  desc "because the one thing a key may NOT do is create an app, and a record"
  desc "bound to the wrong bundle id fails at the END of a 20-minute build."
  lane :create_app_record do
    require "spaceship"
    Spaceship::ConnectAPI.token =
      Spaceship::ConnectAPI::Token.from(hash: asc_api_key)

    identifier = "de.deskilo.app"

    # 1. The bundle id, in the Developer Portal. An app record cannot be
    # bound to an identifier Apple has never seen.
    bundle = Spaceship::ConnectAPI::BundleId.find(identifier)
    if bundle.nil?
      UI.message("Registering bundle id #{identifier}…")
      bundle = Spaceship::ConnectAPI::BundleId.create(
        name: "DesKilo",
        identifier: identifier,
        platform: Spaceship::ConnectAPI::BundleIdPlatform::IOS,
      )
      UI.success("Registered #{identifier}.")
    else
      UI.success("Bundle id #{identifier} is registered.")
    end

    # 2. What App Store Connect actually holds. Apple forbids 'apps' CREATE
    # to API keys of every role ("The resource 'apps' does not allow
    # 'CREATE'"), so the record is made in the web UI — and this lane's job
    # is to tell you whether the one you made points at the right thing.
    app = Spaceship::ConnectAPI::App.find(identifier)
    if app
      UI.success("App record OK: #{app.name} (id #{app.id}) → #{app.bundle_id}")
      next
    end

    UI.important("No app record is bound to #{identifier}.")
    UI.important("App Store Connect holds these apps:")
    Spaceship::ConnectAPI::App.all.each do |a|
      UI.important("  · #{a.name} — #{a.bundle_id} (id #{a.id})")
    end
    UI.user_error!(
      "Create the app in App Store Connect (Apps → +) with bundle id " \
      "#{identifier}, or fix the bundle id of an existing record under " \
      "App Information — it stays editable until the first build is " \
      "uploaded. An API key may not create apps, whatever its role.")
  end

  desc "End-to-end CI release: fetch certs, build, upload to TestFlight."
  desc "Pass distribute_external:true to also push the build to the external"
  desc "'Coworking externe' group (forwarded to upload_testflight)."
  lane :release_testflight do |options|
    match(type: "appstore", api_key: asc_api_key)
    build_appstore(build_number: options[:build_number])
    upload_testflight(
      changelog: options[:changelog],
      distribute_external: options[:distribute_external],
    )
  end

  desc "Fetch (or, in the sync workflow, mint) the DEVELOPER ID certificate"
  desc "the macOS build is signed and notarised with. A different animal"
  desc "from the App Store certificate: Developer ID is what lets a DMG"
  desc "downloaded from anywhere open on a double-click."
  lane :match_developer_id do |options|
    match(
      type: "developer_id",
      api_key: asc_api_key,
      app_identifier: ["de.deskilo.app"],
      # Minting is a portal write, so only the explicit sync run may do it.
      readonly: !options[:write],
      platform: "macos",
    )
  end

  desc "Push the App Store listing (text + URLs) from fastlane/metadata/ios."
  desc "Text only: no binary, no screenshots, nothing submitted for review —"
  desc "so it is safe to re-run at any time. Five locales, the same five the"
  desc "app itself speaks."
  lane :upload_metadata do
    deliver(
      api_key: asc_api_key,
      app_identifier: "de.deskilo.app",
      # The Android listing lives under fastlane/metadata/android; deliver
      # would read every directory here as a locale, so iOS gets its own.
      metadata_path: "../fastlane/metadata/ios",
      skip_binary_upload: true,
      skip_screenshots: true,
      skip_app_version_update: true,
      # Never opens a review submission, and never asks a question a CI
      # runner cannot answer.
      submit_for_review: false,
      automatic_release: false,
      force: true,
      precheck_include_in_app_purchases: false,
      run_precheck_before_submit: false,
    )
  end

  desc "Attach the newest PROCESSED TestFlight build to the editable App"
  desc "Store version. App Store Connect shows the placeholder GRID next to"
  desc "the app in the Apps list until a build is linked to a version — the"
  desc "icon in the list is the linked build's icon (Sparkilo shows its"
  desc "icon because its 6.0 version carries a build). Linking only; never"
  desc "submits anything for review."
  lane :attach_build_to_version do
    require "spaceship"
    Spaceship::ConnectAPI.token =
      Spaceship::ConnectAPI::Token.from(hash: asc_api_key)

    app = Spaceship::ConnectAPI::App.find("de.deskilo.app")
    UI.user_error!("No app record for de.deskilo.app") if app.nil?

    version = app.get_edit_app_store_version(
      platform: Spaceship::ConnectAPI::Platform::IOS,
    )
    UI.user_error!(
      "No editable iOS App Store version — create one in ASC first.",
    ) if version.nil?

    build = app.get_builds(
      filter: { processingState: "VALID" },
      sort: "-uploadedDate",
      limit: 1,
    ).first
    UI.user_error!(
      "No fully processed (VALID) build on this app — upload one via " \
      "release_testflight and wait for Apple's processing, then re-run.",
    ) if build.nil?

    version.select_build(build_id: build.id)
    UI.success("Attached build #{build.version} to App Store version " \
               "#{version.version_string} — the Apps list now shows the " \
               "real icon.")
  end

  # ── TestFlight testers ──────────────────────────────────────────────
  #
  # Ported from tankstellen's manage_testers (only the bundle id differs):
  # the ASC tester API has enough sharp edges — an address that already
  # exists in another group, a pending invitation that cannot be re-sent,
  # internal groups needing a Users-and-Access account — that re-deriving
  # the flow would only re-discover them.

  desc "Create the EXTERNAL beta group, optionally with a public link."
  desc "An external tester needs no App Store Connect account — only an"
  desc "email, or nothing at all if the group carries a public link, which"
  desc "is the TestFlight equivalent of the Play internal-test URL. The"
  desc "price is Beta App Review on the first build; every build after that"
  desc "reaches the group directly."
  desc "Options: name (default 'Coworking externe'), public_link (default"
  desc "true), limit (public-link tester cap, default 100)."
  lane :create_external_group do |options|
    require "spaceship"
    Spaceship::ConnectAPI.token =
      Spaceship::ConnectAPI::Token.from(hash: asc_api_key)

    app = Spaceship::ConnectAPI::App.find("de.deskilo.app")
    UI.user_error!("No app record for de.deskilo.app") if app.nil?

    name = options[:name] || "Coworking externe"
    wants_link = options[:public_link].to_s != "false"

    group = app.get_beta_groups.find { |g| g.name == name }
    if group
      UI.success("Beta group '#{name}' already exists.")
    else
      group = Spaceship::ConnectAPI::BetaGroup.create(
        app_id: app.id,
        name: name,
        is_internal_group: false,
        # Every uploaded build reaches the group without a second action —
        # the same bargain the internal group already makes.
        has_access_to_all_builds: true,
      )
      UI.success("Created external beta group '#{name}'.")
    end

    if wants_link
      # publicLinkEnabled is an UPDATE on the group; the limit is what
      # stops a shared URL turning into an unbounded invitation.
      group.update(attributes: {
        publicLinkEnabled: true,
        publicLinkLimitEnabled: true,
        publicLinkLimit: (options[:limit] || 100).to_i,
      })
      group = app.get_beta_groups.find { |g| g.name == name }
      UI.success("Public link: #{group.public_link || '(pending — Apple mints it within a minute)'}")
    end
  end

  desc "Add external TestFlight tester(s) to the app's beta group(s)."
  desc "Inputs (lane options or ENV): email (required — a single address or a"
  desc "comma-separated list), groups (optional comma list — when omitted, each"
  desc "tester is added to EVERY external beta group so they receive all current"
  desc "and future builds), and an optional first_name / last_name. Idempotent:"
  desc "re-adding an existing tester is a no-op, not a failure, AND an address"
  desc "that already exists in another group is still joined to the target group"
  desc "(verified by re-fetch). Auth = the same App Store Connect API key as"
  desc "upload_testflight (asc_api_key)."
  lane :manage_testers do |options|
    raw_email = options[:email] || ENV["TESTFLIGHT_TESTER_EMAIL"]
    emails = raw_email.to_s.split(",").map(&:strip).reject(&:empty?)
    UI.user_error!("manage_testers requires an `email` (lane option or TESTFLIGHT_TESTER_EMAIL) — a single address or a comma-separated list.") if emails.empty?

    first_name = options[:first_name] || ENV["TESTFLIGHT_TESTER_FIRST_NAME"]
    last_name = options[:last_name] || ENV["TESTFLIGHT_TESTER_LAST_NAME"]

    # `groups` may arrive as a comma list (workflow input) or be empty.
    raw_groups = options[:groups] || ENV["TESTFLIGHT_TESTER_GROUPS"] || ""
    requested_groups = raw_groups.to_s.split(",").map(&:strip).reject(&:empty?)

    # Role granted when the tester must be invited as an App Store Connect
    # *user* — the prerequisite for INTERNAL testing (internal testers are
    # team members). Default DEVELOPER: the least-broad role that reliably has
    # TestFlight build access; overridable via the `role` input. The invite is
    # always scoped to THIS app only (no all-apps visibility, no provisioning).
    role = (options[:role] || ENV["TESTFLIGHT_TESTER_ROLE"] || "DEVELOPER").to_s.strip.upcase

    # #3088 — resend mode: re-issue a FRESH invite to a tester who lost theirs
    # (e.g. a phone reset). A current external member / a pending ASC invite
    # can't otherwise be re-sent, so we remove+re-add (external) or
    # delete+recreate the UserInvitation (internal) to trigger a new email.
    resend = [true, "true", "1"].include?(options[:resend])

    # Authenticate Spaceship's ConnectAPI directly with the same key the
    # upload lane uses. `asc_api_key` returns the `app_store_connect_api_key`
    # hash; `Token.from(hash:)` is exactly how pilot's own Manager logs in
    # (pilot/lib/pilot/manager.rb), so we reuse the proven path and then
    # drive the BetaGroup/BetaTester/User models for full control over the
    # group enumeration, the internal-user invitation flow and idempotency.
    api_token = Spaceship::ConnectAPI::Token.from(hash: asc_api_key)
    Spaceship::ConnectAPI.token = api_token

    # Explicit app lookup by bundle id — mirrors upload_testflight's reasoning
    # for passing the IDs explicitly rather than letting the API enumerate
    # apps from the key alone.
    app = Spaceship::ConnectAPI::App.find("de.deskilo.app")
    UI.user_error!("Could not find app de.deskilo.app on App Store Connect.") if app.nil?

    all_groups = app.get_beta_groups
    external_groups = all_groups.reject(&:is_internal_group)
    internal_groups = all_groups.select(&:is_internal_group)

    UI.message("TestFlight beta groups for #{app.name}:")
    all_groups.each do |g|
      kind = g.is_internal_group ? "internal" : "external"
      UI.message("  - #{g.name} (#{kind})")
    end

    target_groups =
      if requested_groups.empty?
        # No groups given → prefer EVERY external group (an external tester
        # needs no ASC account). When the app has NO external group at all,
        # fall back to the internal group(s) so a freshly-set-up app (only the
        # default internal "iPhone Tester" group) still enrolls the tester —
        # via the internal-user flow below.
        if external_groups.empty?
          UI.message("No external groups exist — targeting ALL internal beta groups (internal-tester flow).")
          internal_groups
        else
          UI.message("No `groups` given — adding #{emails.join(', ')} to ALL external beta groups.")
          external_groups
        end
      else
        matched = all_groups.select { |g| requested_groups.include?(g.name) }
        missing = requested_groups - matched.map(&:name)
        UI.important("Requested group(s) not found and skipped: #{missing.join(', ')}") unless missing.empty?
        matched
      end

    if target_groups.empty?
      UI.user_error!(
        "No target beta group(s) to add the tester to. " \
        "Create a beta group under TestFlight first, or pass an existing " \
        "`groups` name.",
      )
    end

    external_targets = target_groups.reject(&:is_internal_group)
    internal_targets = target_groups.select(&:is_internal_group)

    # Find a tester by email with their group memberships hydrated, returning the
    # BetaTester model or nil. We use the ACCOUNT-SCOPED finder
    # `Spaceship::ConnectAPI::BetaTester.find(email:)` (spaceship .../models/
    # beta_tester.rb → global GET /v1/betaTesters?filter[email]=…) rather than
    # the APP-SCOPED `app.get_beta_testers(filter: {email:})` that the previous
    # implementation used. App#get_beta_testers injects `filter[:apps] = app.id`
    # (spaceship .../models/app.rb), so a tester who exists on the account but
    # is not yet indexed against THIS app returns nil — which is exactly why the
    # live run could not find fdittgen@gmail.com after assignment and never
    # landed the tester in 'extern' (#2613). The account-scoped find sees the
    # tester regardless of app association.
    find_tester = lambda do |addr|
      Spaceship::ConnectAPI::BetaTester.find(email: addr, includes: "betaGroups")
    end

    in_group = lambda do |betatester, group|
      return false if betatester.nil?
      (betatester.beta_groups || []).any? { |g| g.id == group.id }
    end

    # Add `addr` to `group` and PROVE it landed, mirroring pilot's own working
    # tester flow (pilot/lib/pilot/tester_manager.rb#add_tester) but split into
    # the create-new vs add-existing branches and followed by a verification:
    #
    #   * find by email   → Spaceship::ConnectAPI::BetaTester.find(email:)
    #   * EXISTING tester → group.add_beta_testers(beta_tester_ids: [tester.id])
    #                       (spaceship BetaGroup#add_beta_testers →
    #                        POST /v1/betaGroups/{id}/relationships/betaTesters)
    #   * NEW tester      → Spaceship::ConnectAPI.post_beta_tester_assignment(
    #                        beta_group_ids: [group.id], attributes: {...})
    #                       (spaceship testflight.rb → POST /v1/betaTesters with
    #                        the betaGroups relationship — creates the tester
    #                        already attached to the target group)
    #
    # The previous code only ever called the bulk-assignment endpoint and then
    # an app-scoped find; when the address already existed in ANOTHER group the
    # bulk endpoint returns 200 with a per-tester error (it does NOT raise), so
    # nothing was added and the find found nothing either — reported as the live
    # "could not be found as a beta tester after assignment" failure (#2613).
    assign_to = lambda do |addr, info, group, kind|
      existing = find_tester.call(addr)
      UI.message("[manage_testers] find(#{addr}) → " \
                 "#{existing ? "tester id #{existing.id}" : 'nil (not yet a tester)'}; " \
                 "target #{kind} group '#{group.name}' (#{group.id}).")

      if existing && in_group.call(existing, group)
        if resend
          # #3088 resend: fully remove the tester from the app, then re-create
          # below (create-new path), so App Store Connect issues a FRESH
          # TestFlight invite email — re-adding a current member is a no-op, so
          # a lost invite can't otherwise be re-sent.
          UI.message("[manage_testers] resend — removing #{addr} from #{app.name} to re-issue the invite.")
          existing.delete_from_apps(apps: [app])
          existing = nil
        else
          # Truly already a member of the target group → idempotent no-op.
          UI.success("#{addr} is already in #{kind} beta group '#{group.name}' — nothing to do.")
          return true
        end
      end

      begin
        if existing
          # EXISTING tester (possibly only in another group) → attach to this
          # group via the relationship endpoint.
          UI.message("[manage_testers] path=add-existing — attaching tester #{existing.id} to '#{group.name}'.")
          group.add_beta_testers(beta_tester_ids: [existing.id])
        else
          # NEW tester → create it already attached to the target group.
          UI.message("[manage_testers] path=create-new — creating #{addr} attached to '#{group.name}'.")
          Spaceship::ConnectAPI.post_beta_tester_assignment(
            beta_group_ids: [group.id],
            attributes: {
              email: addr,
              firstName: info[:firstName],
              lastName: info[:lastName],
            },
          )
        end
      rescue => ex
        message = ex.message.to_s
        if message =~ /already|exist|duplicat/i
          # Concurrent / prior partial run already attached it — fine; the
          # verification below confirms the real state.
          UI.message("[manage_testers] add reported already-exists for #{addr} in '#{group.name}'; verifying.")
        else
          UI.error("Failed to add #{addr} to '#{group.name}': #{message}")
          return false
        end
      end

      # VERIFY by re-fetching (account-scoped) and asserting target-group
      # membership. Only claim success when the email is genuinely present.
      verified = find_tester.call(addr)
      member = in_group.call(verified, group)
      UI.message("[manage_testers] post-verify #{addr} → groups: " \
                 "#{verified ? (verified.beta_groups || []).map(&:name).join(', ') : '(tester not found)'}; " \
                 "in '#{group.name}'? #{member}.")
      if member
        UI.success("#{addr} is in #{kind} beta group '#{group.name}'.")
        true
      else
        UI.error("#{addr} is STILL NOT in '#{group.name}' after assignment — " \
                 "membership could not be verified. Check the App Store Connect " \
                 "API key permissions and the group configuration.")
        false
      end
    end

    emails.each do |email|
      info = { email: email, firstName: first_name, lastName: last_name }
      failures = []

      # ---- External groups: a plain email assignment (no ASC account needed).
      external_targets.each do |group|
        failures << group.name unless assign_to.call(email, info, group, "external")
      end

      # ---- Internal groups: internal testers must be App Store Connect *users*
      # first. Ensure the user exists (invite — scoped to this app — if not),
      # then assign to the internal group(s). The invite is accepted out-of-band
      # by the tester via email, so assigning a freshly-invited (not-yet-
      # accepted) user is deferred to a later re-run and reported clearly.
      unless internal_targets.empty?
        begin
          existing_user = Spaceship::ConnectAPI::User.all.find { |u| u.email.to_s.casecmp?(email) }
          pending_invite = Spaceship::ConnectAPI::UserInvitation.all.find { |i| i.email.to_s.casecmp?(email) }

          if !existing_user.nil?
            # Accepted team user → assign to the internal group(s) now (verified).
            internal_targets.each do |group|
              failures << group.name unless assign_to.call(email, info, group, "internal")
            end
          elsif !pending_invite.nil? && resend
            # #3088 resend: a pending (un-accepted) invite can't be re-sent in
            # place — delete it and create a fresh one so a NEW email goes out.
            UI.message("#{email} has a PENDING invitation — deleting + re-creating it to re-send a fresh email.")
            pending_invite.delete!
            Spaceship::ConnectAPI::UserInvitation.create(
              email: email,
              first_name: (first_name && !first_name.empty?) ? first_name : email.split("@").first,
              last_name: (last_name && !last_name.empty?) ? last_name : "Tester",
              roles: [role],
              provisioning_allowed: false,
              all_apps_visible: false,
              visible_app_ids: [app.id],
            )
            UI.success("Fresh App Store Connect invitation re-sent to #{email}. Once they accept the " \
                       "email, re-run this workflow to place them in: #{internal_targets.map(&:name).join(', ')}.")
          elsif !pending_invite.nil?
            UI.important("#{email} already has a PENDING App Store Connect invitation. " \
                         "Ask them to accept it, then re-run this workflow to complete the " \
                         "internal-group assignment for: #{internal_targets.map(&:name).join(', ')}.")
          else
            UI.message("#{email} is not yet an App Store Connect user — sending a " \
                       "Users-and-Access invitation (role #{role}, scoped to #{app.name} only).")
            Spaceship::ConnectAPI::UserInvitation.create(
              email: email,
              first_name: (first_name && !first_name.empty?) ? first_name : email.split("@").first,
              last_name: (last_name && !last_name.empty?) ? last_name : "Tester",
              roles: [role],
              provisioning_allowed: false,
              all_apps_visible: false,
              visible_app_ids: [app.id],
            )
            UI.success("Invitation sent to #{email}. Once they accept the email and become a " \
                       "team user, re-run this workflow to place them in: " \
                       "#{internal_targets.map(&:name).join(', ')}.")
          end
        rescue => ex
          # The ASC *API key* itself carries a role. Inviting / listing users is
          # a Users-and-Access (Admin) capability — an App-Manager-scoped key
          # gets FORBIDDEN here. Surface that as an actionable message instead of
          # a raw stack trace.
          message = ex.message.to_s
          if message =~ /forbid|permission|not.*(allowed|permitted)|403|unauthor/i
            # #3090 — an App-Manager-scoped key CAN'T manage Users and Access by
            # design, so the internal-tester flow is forbidden. That's a known
            # config limitation, NOT a transient failure: WARN and continue
            # rather than aborting the whole run RED — the external-group path
            # (which this key CAN do) has already run for this tester. The
            # maintainer completes the internal invite manually (App Store
            # Connect → Users and Access) or re-issues the key with the Admin
            # role. The end-of-lane summary still lists the internal target.
            UI.important(
              "SKIPPED internal-tester management for #{email}: the App Store " \
              "Connect API key lacks Users-and-Access permission. Re-issue the key " \
              "with the Admin role, or add #{email} manually in App Store Connect → " \
              "Users and Access → #{internal_targets.map(&:name).join(', ')}. (#{message})",
            )
          else
            raise ex
          end
        end
      end

      unless failures.empty?
        UI.user_error!("#{email}: could not verify membership in group(s): #{failures.uniq.join(', ')}.")
      end
    end

    ext_summary = external_targets.empty? ? "(none)" : external_targets.map(&:name).join(", ")
    int_summary = internal_targets.empty? ? "(none)" : internal_targets.map(&:name).join(", ")
    UI.success("Done. Tester(s): #{emails.join(', ')}. External group(s): #{ext_summary}. Internal target(s): #{int_summary}.")
  end
end
