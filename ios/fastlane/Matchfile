# DesKilo keeps its OWN certs repo, with its own passphrase.
#
# Sharing tankstellen's was the first design (one distribution certificate
# for the team, one repo), and it is the tidier one — but it hinges on a
# passphrase that turned out to be unrecoverable, and re-encrypting a repo
# Sparkilo depends on to solve a DesKilo problem is not a trade worth
# making. So: a second repo, a second passphrase, and a second Apple
# Distribution certificate minted on first sync (Apple allows three per
# team; creating one does not touch the one tankstellen holds).
#
# CI clones via a deploy key (webfactory/ssh-agent in the workflow); local
# devs use their personal GitHub SSH key.
git_url("git@github.com:fdittgen-png/deskilo-ios-certs.git")
storage_mode("git")

type("appstore")
app_identifier(["de.deskilo.app"])
team_id("C4Y5RDF8P9")

# CI must always run match in readonly mode — only the explicit sync/repair
# lane may mint profiles, since that touches the Apple Developer Portal and
# writes to the encrypted match repo.
readonly(ENV["CI"] == "true")
